# Chickado Environment Variables Configuration Example
# Copy to .env.local for local development. NEVER commit real secrets to source control.

# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://chickadopk.com

# Admin Authentication & Security
ADMIN_JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_for_production
ADMIN_SESSION_COOKIE_NAME=chickado_admin_session

# Database Configuration (MySQL with least-privileged user)
# Dedicated user 'chickado_app' with SELECT, INSERT, UPDATE, DELETE permissions only.
DATABASE_URL="mysql://chickado_app:strong_random_password_here@127.0.0.1:3306/chickado_db"

# WhatsApp Hotline & Kitchen Dispatch
NEXT_PUBLIC_WHATSAPP_NUMBER=923316633141
NEXT_PUBLIC_STORE_PHONE="0331 6633141"

